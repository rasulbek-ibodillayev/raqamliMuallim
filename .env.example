# Nusxalab .env deb saqlang (git'ga qo'shilmaydi). Qiymatlarni hech kimga yubormang.

# Serverda shart, kamida 32 belgi: python -c "import secrets; print(secrets.token_hex(32))"
# Almashtirilsa hamma foydalanuvchi bir marta qayta kiradi, berilgan havolalar ishlamay qoladi
SECRET_KEY=
DATABASE_URL=postgresql+psycopg://raqamli:raqamli@localhost:5432/raqamli

# Ilova oldidagi proksilar soni (nginx — 1). Proksisiz bo'sh qolsin
RM_PROXY_HOPS=
# Ruxsat etilgan domenlar, vergul bilan. Masalan: raqamlimuallim.uz,www.raqamlimuallim.uz
RM_HOSTS=

# Fon vazifalari veb-jarayon ichida ishlasin. Alohida jarayon kerak bo'lsa bo'sh qoldirib, worker.py ni ishga tushiring
RM_WORKER=1

# Google orqali kirish
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
